// Example: built-in 2880x1800 laptop panel at 1.5 scale.
// List your own connectors and modes with: niri msg outputs

output "eDP-1" {
    // `mode` is omitted on purpose: niri already uses the panel's preferred mode.
    // `scale` must be explicit; otherwise niri guesses it from physical size.
    scale 1.5

    // Anchor the laptop panel at the origin so an external display attached on
    // the right stays on the right.
    position x=0 y=0
}
