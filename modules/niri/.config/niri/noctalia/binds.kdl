binds {
    // App shortcuts
    Mod+E repeat=false hotkey-overlay-title="File Manager" { spawn "nautilus"; }

    Ctrl+Shift+Escape repeat=false hotkey-overlay-title="Task Manager" { spawn "noctalia" "msg" "panel-toggle" "control-center" "system"; }
    // No workspace-rename bind yet (Noctalia doesn't expose one).
    Ctrl+XF86AudioLowerVolume repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    Ctrl+XF86AudioRaiseVolume repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    Mod+L repeat=false hotkey-overlay-title="Lock Screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+I repeat=false hotkey-overlay-title="Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+D repeat=false hotkey-overlay-title="Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+P repeat=false hotkey-overlay-title="Power Menu: Toggle" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    // No notepad bind yet (Noctalia doesn't expose one).
    Mod+Space repeat=false hotkey-overlay-title="Application Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+V repeat=false hotkey-overlay-title="Clipboard Manager" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+W repeat=false hotkey-overlay-title="Next Wallpaper" { spawn "noctalia" "msg" "wallpaper-next"; }
    Mod+Shift+W repeat=false hotkey-overlay-title="Random Wallpaper" { spawn "noctalia" "msg" "wallpaper-random"; }
    Mod+O repeat=false hotkey-overlay-title="OSD" { spawn "noctalia" "msg" "osd-toggle"; }
    // Keeps the screen awake: holds an idle inhibitor, so the 5-minute
    // screen-off in ~/.config/noctalia/config.toml is suspended while active.
    Mod+Shift+C repeat=false hotkey-overlay-title="Caffeine: Toggle" { spawn "noctalia" "msg" "caffeine-toggle"; }
    // Media keys (also work while locked)
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMicMute repeat=false allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioMute repeat=false allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioNext repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPause repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPlay repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPrev repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Alt+Print repeat=false { spawn "noctalia" "msg" "screenshot-region"; }
    Alt+XF86Launch1 repeat=false { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Down { focus-window-down; }
    Mod+End { focus-column-last; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F repeat=false { fullscreen-window; }
    Mod+Home { focus-column-first; }
    Mod+Left { focus-column-left; }
    Mod+M repeat=false { maximize-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Period { expel-window-from-column; }
    Mod+Q repeat=false { close-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+Right { move-column-right; }
    Mod+T repeat=false hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+V repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Up { focus-window-up; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+Y repeat=false { toggle-column-tabbed-display; }
    Mod+Shift+P repeat=false { spawn "noctalia" "msg" "dpms-off"; }
    Ctrl+Print repeat=false { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Ctrl+XF86Launch1 repeat=false { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Print repeat=false { spawn "noctalia" "msg" "screenshot-region"; }
    XF86Launch1 repeat=false { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Shift+Q repeat=false hotkey-overlay-title="Quit Niri" { quit; }
    Mod+Return repeat=false hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
    Mod+Escape repeat=false allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Slash repeat=false { show-hotkey-overlay; }
    Mod+Tab repeat=false { toggle-overview; }
}
