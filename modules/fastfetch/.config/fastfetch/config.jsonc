{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 0,
            "left": 2,
            "right": 4
        },
        "color": {
            "1": "#7d7d7d",
            "2": "#c6c6c6"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#919191",
            "title": "#e2e2e2"
        },
        "percent": {
            "type": 1
        }
    },
    "modules": [
        {
            "type": "title",
            "key": " "
        },
        "os",
        "kernel",
        "uptime",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
